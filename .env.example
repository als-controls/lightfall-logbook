# lightfall-logbook environment configuration
# Copy to /opt/lightfall-logbook/.env and edit

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=2

# Database — async SQLAlchemy URL
# SQLite (default):
DATABASE_URL=sqlite+aiosqlite:///./logbook.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://lightfall:password@localhost:5432/logbook

# Keycloak auth (required in production)
# KEYCLOAK_URL=https://keycloak.example.com
# KEYCLOAK_REALM=als
# KEYCLOAK_CLIENT_ID=lightfall-logbook
# KEYCLOAK_AUDIENCE=  (optional, skips audience verification if empty)

# Scoped settings: scope tree, facility grants, pre-approved keys (TOML).
# Unset = facility scope only, default grants, no seeds.
# SCOPES_CONFIG=/opt/lightfall-logbook/scopes.toml

# Local development only: trust X-User-Id / X-User-Groups headers when Keycloak is unset.
# LOGBOOK_DEV_MODE=1
